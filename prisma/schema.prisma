generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // Plain string ("user" | "admin"), consistent with every other enum-like
  // field in this schema. The first admin is designated via the ADMIN_EMAIL
  // env var (see src/lib/admin.ts) — never trusted from the JWT session,
  // always re-read from the DB in src/lib/admin-dal.ts.
  role         String   @default("user")
  // E.164 ("+5511999999999"). Required at signup, and the key the WhatsApp
  // side works from: it proves an inbound message belongs to this user, and
  // it is what an event's group is built out of. Nullable only because
  // accounts created before it was required still exist.
  phoneNumber  String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  pluggyItems  PluggyItem[]
  financings   Financing[]

  apiTokens        ApiToken[]
  inboundMessages  InboundMessage[]

  createdEvents       Event[]             @relation("EventCreator")
  eventParticipations EventParticipant[]
  paidEventExpenses   EventExpense[]      @relation("EventExpensePayer")
  eventExpenseSplits  EventExpenseSplit[]
  uploadedReceipts    EventReceipt[]
}

// One bank connection made through the Open Finance aggregator (Pluggy).
model PluggyItem {
  id                String    @id @default(cuid())
  userId            String
  pluggyItemId      String    @unique
  connectorName     String
  connectorImageUrl String?
  status            String // UPDATED, UPDATING, LOGIN_ERROR, OUTDATED, WAITING_USER_INPUT, ERROR
  executionStatus   String?
  lastSyncedAt      DateTime?
  // Last failure message, cleared on the next successful sync, so the UI can
  // say what actually went wrong instead of a generic "erro".
  lastSyncError     String?
  // Set while a sync is in flight and cleared when it ends. Two syncs of the
  // same item (a webhook landing while the user hits "sincronizar") would
  // otherwise both walk the same pages and fight over the same rows.
  syncStartedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId])
}

model Account {
  id       String  @id @default(cuid())
  userId   String
  name     String
  type     String // checking, savings, credit_card, cash, investment
  balance  Float   @default(0)
  currency String  @default("BRL")
  color    String  @default("#6366f1")
  archived Boolean @default(false)

  // Only meaningful for type: "credit_card" — left null for every other
  // type. Day-of-month (1-31); a value past the account's actual month
  // length is intentionally allowed and just clamped for display (see
  // addMonthsUTC-style handling), same as Financing's schedule dates.
  creditLimit Float?
  closingDay  Int?
  dueDay      Int?

  // Set when this account was created via Open Finance sync instead of manually.
  pluggyItemId    String?
  pluggyAccountId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pluggyItem   PluggyItem?   @relation(fields: [pluggyItemId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  financings   Financing[]

  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String // income, expense
  color     String
  icon      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  financings   Financing[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  categoryId  String?
  description String
  amount      Float // always positive; sign is derived from `type`
  date        DateTime
  type        String // income, expense, transfer
  notes       String?

  // Set when this transaction was imported via Open Finance sync. Scoped to
  // (userId, pluggyTransactionId) rather than a bare unique so an id can
  // never let a sync upsert cross into another user's row.
  pluggyTransactionId String?
  merchantName        String?
  pluggyCategory       String?

  // Set when this transaction is one installment of a Financing. Every
  // transaction not created that way keeps financingId null and
  // balanceApplied true, so nothing about existing behavior changes.
  financingId       String?
  installmentNumber Int? // 1-based position within the financing; fixed at creation, never renumbered
  // The realizado/previsto flag for EVERY transaction, not just financing
  // installments: true means the money actually moved and Account.balance
  // already reflects it; false means it is only scheduled. A pending row
  // past its date is what the app calls "atrasada". Defaults to true, so a
  // plain transaction keeps behaving exactly as it always has.
  balanceApplied Boolean @default(true)

  // Set when this transaction came in through the public API (WhatsApp via
  // n8n, or any other automation) rather than the web UI.
  source         String  @default("app") // app, whatsapp, api, openfinance

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  financing Financing? @relation(fields: [financingId], references: [id], onDelete: Cascade)

  @@unique([userId, pluggyTransactionId])
  @@unique([financingId, installmentNumber])
  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
  @@index([financingId])
}

// One repeating money plan: a financiamento/parcelamento (N installments
// of R$V), a gasto fixo (aluguel, assinatura), or a receita fixa (salário).
// All three are the same thing mechanically — N occurrences spaced by
// `frequency` — and differ only in `type`, `isRecurring` and how they read.
// The Financing
// row itself is metadata; the actual N Transaction rows (linked via
// financingId) are what drive balances, the dashboard, and budgets — no
// extra code was needed there, since a normal expense-type Transaction
// dated into a given month already counts toward that month everywhere.
model Financing {
  id                String   @id @default(cuid())
  userId            String
  accountId         String
  categoryId        String?
  description       String
  // "expense" (aluguel, assinatura, parcela) or "income" (salário, aluguel
  // que você recebe). Every installment Transaction is created with this
  // type, which is what decides the sign of its balance effect.
  type              String   @default("expense")
  installmentAmount Float // V — always positive, one installment's value
  installmentCount  Int // N — total number of installments (a recurring expense just uses a long practical cap, see isRecurring)
  firstDueDate      DateTime // calendar date (UTC midnight) of installment #1
  // How far apart consecutive installments fall: weekly, biweekly (every
  // 15 days), monthly, quarterly, semiannual, annual — see
  // src/lib/recurrence.ts. Defaults to "monthly", which is exactly what
  // every row created before this field existed already was.
  frequency         String   @default("monthly")
  // True for a fixed monthly expense with no real end date (rent, a
  // subscription with no planned cancellation, ...). installmentCount is
  // still a normal finite number under the hood — see
  // recurringOccurrenceCount in src/lib/recurrence.ts — so it reuses the
  // exact same schedule/
  // reconciliation machinery; this flag only changes how it's displayed
  // (no "X of Y" progress, no meaningful total).
  isRecurring       Boolean  @default(false)
  // True (the default, and what every row created before this field
  // existed already did) = the installment hits the balance on its own the
  // moment it comes due, for things really debited automatically. False =
  // it stays pending until the user confirms payment, and shows up as
  // atrasada once the due date passes.
  autoSettle        Boolean  @default(true)
  // Set when an open-ended entry is ended by the user. Without it, the
  // rolling extender would simply regenerate the occurrences that
  // "Encerrar" had just removed.
  canceledAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  installments Transaction[]

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
}

// A bearer token for the public API — how an automation (the n8n WhatsApp
// agent) acts on one user's behalf. Only the hash is ever stored, exactly
// like a password: the plaintext is shown once at creation and cannot be
// recovered afterwards.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  // SHA-256 of the token. Unique so a lookup is a single indexed read
  // rather than a scan comparing every row.
  tokenHash  String    @unique
  // First characters of the plaintext ("fbot_a1b2"), so the UI can tell two
  // tokens apart without being able to reconstruct either.
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One inbound automation message. Exists for idempotency above all:
// WhatsApp providers retry aggressively, and without a dedupe key a single
// "gastei 50 no mercado" can post three times. externalId is whatever
// message id the provider sent; scoped per user so one user's ids can
// never collide with another's.
model InboundMessage {
  id         String   @id @default(cuid())
  userId     String
  externalId String
  channel    String // whatsapp, api
  body       String
  // The transaction this message created, when it created one. Null for a
  // message that was a question ("quanto gastei?") or that failed to parse.
  resultId   String?
  status     String // created, duplicate, failed, answered
  reply      String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@index([userId, createdAt])
}

// One thing that happened in the app and that an automation may want to
// act on — an event being created, someone joining it, an expense being
// added. Rows are the queue: written in the same breath as the change
// itself, then delivered to N8N_WEBHOOK_URL with retries.
//
// A queue rather than a direct call because the two must not share a fate:
// a webhook that is down cannot be allowed to fail the expense the user
// just recorded, and a delivery that fails deserves another try later.
model OutboundEvent {
  id            String    @id @default(cuid())
  userId        String?
  eventId       String?
  type          String // event.created, event.participant_joined, event.expense_created, ...
  payload       Json
  status        String    @default("pending") // pending, delivered, failed
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, nextAttemptAt])
  @@index([eventId])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     Float
  month      Int // 1-12
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
}

// Shared expense group ("rachar a conta"). This is the one deliberate
// exception to per-user data isolation: everything under an Event is only
// ever visible to its participants, enforced centrally in lib/events-dal.ts
// (verifyEventAccess) rather than repeated ad hoc in each query/action.
model Event {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Nullable so the event survives its creator's account being deleted —
  // it belongs to the group, not to one member.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Set by the automation after it actually creates the group, via the
  // callback route — the app never talks to WhatsApp itself.
  whatsappGroupId     String?
  // none (nobody asked for a group) | pending (asked, waiting on the
  // automation) | created | failed
  whatsappGroupStatus String  @default("none")

  createdBy    User?              @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants EventParticipant[]
  expenses     EventExpense[]
  invites      EventInvite[]
  receipts     EventReceipt[]

  @@index([createdById])
}

model EventParticipant {
  id       String   @id @default(cuid())
  eventId  String
  userId   String
  joinedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// Shareable join link. `code` is a high-entropy random token — knowing it
// is what grants access to join, so it must never be guessable or listed.
model EventInvite {
  id          String    @id @default(cuid())
  eventId     String
  code        String    @unique
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  revoked     Boolean   @default(false)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventExpense {
  id          String   @id @default(cuid())
  eventId     String
  description String
  amount      Float
  paidById    String
  date        DateTime @default(now())
  // Set when this expense came from AI-extracted receipt items — several
  // expenses can point at the same receipt (one photo, many line items).
  receiptId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event   Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Restrict (not Cascade/SetNull): a group's shared ledger must never lose
  // who paid what just because that member later deletes their account.
  paidBy  User                @relation("EventExpensePayer", fields: [paidById], references: [id], onDelete: Restrict)
  splits  EventExpenseSplit[]
  // SetNull, not Cascade: the receipt is supporting evidence, not the
  // source of truth — losing the photo must never delete real ledger history.
  receipt EventReceipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([paidById])
  @@index([receiptId])
}

// A photographed nota fiscal / receipt, read by OpenAI's vision API to
// list its line items (src/lib/openai.ts). Stored as bytes directly in
// Postgres — no object-storage/volume setup needed in Coolify, and it
// rides along with the regular DB backup.
model EventReceipt {
  id           String   @id @default(cuid())
  eventId      String
  uploadedById String
  imageData    Bytes
  mimeType     String
  createdAt    DateTime @default(now())

  event      Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Restrict for the same reason as EventExpense.paidBy above.
  uploadedBy User           @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  expenses   EventExpense[]

  @@index([eventId])
  @@index([uploadedById])
}

model EventExpenseSplit {
  id             String @id @default(cuid())
  eventExpenseId String
  userId         String
  amount         Float // this participant's share of the expense

  eventExpense EventExpense @relation(fields: [eventExpenseId], references: [id], onDelete: Cascade)
  // Restrict for the same reason as EventExpense.paidBy above.
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventExpenseId, userId])
  @@index([userId])
}

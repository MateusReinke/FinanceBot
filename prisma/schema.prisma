generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  pluggyItems  PluggyItem[]

  createdEvents       Event[]             @relation("EventCreator")
  eventParticipations EventParticipant[]
  paidEventExpenses   EventExpense[]      @relation("EventExpensePayer")
  eventExpenseSplits  EventExpenseSplit[]
}

// One bank connection made through the Open Finance aggregator (Pluggy).
model PluggyItem {
  id                String    @id @default(cuid())
  userId            String
  pluggyItemId      String    @unique
  connectorName     String
  connectorImageUrl String?
  status            String // UPDATED, UPDATING, LOGIN_ERROR, OUTDATED, WAITING_USER_INPUT, ERROR
  executionStatus   String?
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId])
}

model Account {
  id       String  @id @default(cuid())
  userId   String
  name     String
  type     String // checking, savings, credit_card, cash, investment
  balance  Float   @default(0)
  currency String  @default("BRL")
  color    String  @default("#6366f1")
  archived Boolean @default(false)

  // Set when this account was created via Open Finance sync instead of manually.
  pluggyItemId    String?
  pluggyAccountId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pluggyItem   PluggyItem?   @relation(fields: [pluggyItemId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String // income, expense
  color     String
  icon      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name, type])
  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  categoryId  String?
  description String
  amount      Float // always positive; sign is derived from `type`
  date        DateTime
  type        String // income, expense, transfer
  notes       String?

  // Set when this transaction was imported via Open Finance sync. Scoped to
  // (userId, pluggyTransactionId) rather than a bare unique so an id can
  // never let a sync upsert cross into another user's row.
  pluggyTransactionId String?
  merchantName        String?
  pluggyCategory       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([userId, pluggyTransactionId])
  @@index([userId, date])
  @@index([accountId])
  @@index([categoryId])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  amount     Float
  month      Int // 1-12
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
  @@index([userId, month, year])
}

// Shared expense group ("rachar a conta"). This is the one deliberate
// exception to per-user data isolation: everything under an Event is only
// ever visible to its participants, enforced centrally in lib/events-dal.ts
// (verifyEventAccess) rather than repeated ad hoc in each query/action.
model Event {
  id          String   @id @default(cuid())
  name        String
  description String?
  // Nullable so the event survives its creator's account being deleted —
  // it belongs to the group, not to one member.
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy    User?              @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants EventParticipant[]
  expenses     EventExpense[]
  invites      EventInvite[]

  @@index([createdById])
}

model EventParticipant {
  id       String   @id @default(cuid())
  eventId  String
  userId   String
  joinedAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

// Shareable join link. `code` is a high-entropy random token — knowing it
// is what grants access to join, so it must never be guessable or listed.
model EventInvite {
  id          String    @id @default(cuid())
  eventId     String
  code        String    @unique
  createdById String?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  revoked     Boolean   @default(false)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventExpense {
  id          String   @id @default(cuid())
  eventId     String
  description String
  amount      Float
  paidById    String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event  Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Restrict (not Cascade/SetNull): a group's shared ledger must never lose
  // who paid what just because that member later deletes their account.
  paidBy User                @relation("EventExpensePayer", fields: [paidById], references: [id], onDelete: Restrict)
  splits EventExpenseSplit[]

  @@index([eventId])
  @@index([paidById])
}

model EventExpenseSplit {
  id             String @id @default(cuid())
  eventExpenseId String
  userId         String
  amount         Float // this participant's share of the expense

  eventExpense EventExpense @relation(fields: [eventExpenseId], references: [id], onDelete: Cascade)
  // Restrict for the same reason as EventExpense.paidBy above.
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventExpenseId, userId])
  @@index([userId])
}

# Local dev: `docker compose up -d` starts a matching Postgres on 5432 with
# these exact credentials. In Coolify, point this at the Postgres resource
# you add there instead (see "Deploy no Coolify" in the README).
DATABASE_URL="postgresql://financebot:financebot_dev_pw@localhost:5432/financebot?schema=public"

# Generate with: openssl rand -base64 32
SESSION_SECRET=""

# The session cookie requires HTTPS by default in production (the browser
# silently drops it otherwise — this is what makes login look like it
# "doesn't stick" and every click bounce back to /login). If you're
# accessing the app over plain HTTP — no domain/TLS configured yet in
# Coolify — set this to "false" to unblock testing. Not meant for a real
# deployment: set up a domain with HTTPS in Coolify instead and leave this
# unset. "true"/"false" to force one way, unset to auto-detect via
# X-Forwarded-Proto (works automatically once you do have HTTPS in front).
COOKIE_SECURE=""

# Whoever signs up (or later logs in) with this exact email becomes the
# app's admin, with access to /admin (create/edit/delete/reset-password for
# other users — never their financial data). Leave blank to disable the
# admin panel entirely.
ADMIN_EMAIL=""

# Open Finance (Pluggy) — free sandbox credentials at https://dashboard.pluggy.ai
# Leave blank to run the app with manual accounts only (bank sync UI stays hidden).
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
PLUGGY_USE_SANDBOX="true"

# Optional: set once you have a public URL, so Pluggy can push sync events instead
# of relying on the client polling after Connect widget success.
PLUGGY_WEBHOOK_URL=""

# AI receipt scanning (Events feature): attach a photo of a nota fiscal and
# OpenAI lists its line items automatically. Get a key at
# https://platform.openai.com/api-keys — leave blank to hide the "Ler nota
# fiscal" button entirely (manual expense entry keeps working either way).
OPENAI_API_KEY=""

# Optional: override the vision model used to read receipts. Leave blank
# to use the built-in default (gpt-4o). Use OpenAI's own bare model ID
# (e.g. "o4-mini") — this app calls api.openai.com directly, not a
# router/aggregator, so a namespaced id like "openai/o4-mini" gets
# rejected as invalid.
OPENAI_MODEL=""

# Local dev: `docker compose up -d` starts a matching Postgres on 5432 with
# these exact credentials. In Coolify, point this at the Postgres resource
# you add there instead (see "Deploy no Coolify" in the README).
DATABASE_URL="postgresql://financebot:financebot_dev_pw@localhost:5432/financebot?schema=public"

# Generate with: openssl rand -base64 32
SESSION_SECRET=""

# The session cookie requires HTTPS by default in production (the browser
# silently drops it otherwise — this is what makes login look like it
# "doesn't stick" and every click bounce back to /login). If you're
# accessing the app over plain HTTP — no domain/TLS configured yet in
# Coolify — set this to "false" to unblock testing. Not meant for a real
# deployment: set up a domain with HTTPS in Coolify instead and leave this
# unset. "true"/"false" to force one way, unset to auto-detect via
# X-Forwarded-Proto (works automatically once you do have HTTPS in front).
COOKIE_SECURE=""

# Whoever signs up (or later logs in) with this exact email becomes the
# app's admin, with access to /admin (create/edit/delete/reset-password for
# other users — never their financial data). Leave blank to disable the
# admin panel entirely.
ADMIN_EMAIL=""

# Login com Google + importar contatos. Deixe em branco para desativar: sem
# essas variáveis o botão "Entrar com Google" não aparece e o painel de
# contatos em Configurações some, exatamente como Pluggy e OpenAI.
#
# Como obter, em https://console.cloud.google.com:
#   1. Crie um projeto e vá em "APIs e serviços" > "Tela de permissão OAuth".
#   2. Em "APIs e serviços" > "Biblioteca", ative a "People API".
#   3. Em "Credenciais", crie um "ID do cliente OAuth" do tipo
#      "Aplicativo da Web" e registre a URI de redirecionamento autorizada:
#         https://SEU-DOMINIO/api/auth/google/callback
#      (em dev: http://localhost:3000/api/auth/google/callback)
#
# ATENÇÃO sobre os contatos: o escopo contacts.readonly é "restrito" no
# Google. Enquanto o app não passar pela verificação do Google (que inclui
# uma avaliação de segurança CASA), só as contas adicionadas como
# "usuários de teste" na tela de permissão conseguem autorizar a
# importação — até 100 contas. O login com Google funciona normalmente
# sem isso; só a importação de contatos é que fica limitada.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Opcional: só preencha se a URI registrada no Google for diferente da que o
# app deduz do próprio request (proto/host, respeitando X-Forwarded-*).
GOOGLE_REDIRECT_URI=""

# Open Finance (Pluggy) — free sandbox credentials at https://dashboard.pluggy.ai
# Leave blank to run the app with manual accounts only (bank sync UI stays hidden).
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
PLUGGY_USE_SANDBOX="true"

# Optional: set once you have a public URL, so Pluggy can push sync events instead
# of relying on the client polling after Connect widget success.
PLUGGY_WEBHOOK_URL=""

# Powers two optional AI features: receipt scanning (Events — attach a
# nota fiscal photo, OpenAI lists its line items) and the text assistant
# in the topbar (type "gastei 50 no mercado", it drafts the transaction).
# Get a key at https://platform.openai.com/api-keys — leave blank to hide
# both entirely (manual entry keeps working either way).
OPENAI_API_KEY=""

# Optional: override the model used for both AI features above. Leave
# blank to use the built-in default (gpt-4o). Use OpenAI's own bare model
# ID (e.g. "o4-mini") — this app calls api.openai.com directly, not a
# router/aggregator, so a namespaced id like "openai/o4-mini" gets
# rejected as invalid.
OPENAI_MODEL=""

# Autenticação do webhook do Pluggy. Configure UM dos dois — sem nenhum,
# o endpoint /api/openfinance/webhook recusa todas as chamadas.
# HMAC-SHA256 do corpo, conferido contra o header x-signature (preferido):
PLUGGY_WEBHOOK_SECRET=
# Ou um token na query string, para quando só a URL é configurável.
# O app já anexa ?token=... na URL registrada no Pluggy.
PLUGGY_WEBHOOK_TOKEN=

# Automação de saída (n8n): para onde o app publica o que acontece —
# criação de evento de divisão de contas, entrada de participante e cada
# nova despesa. É o n8n que cria o grupo no WhatsApp e manda as mensagens;
# o app nunca fala com o WhatsApp direto. Sem esta URL, os eventos ficam
# enfileirados e nada é enviado.
N8N_WEBHOOK_URL=
# Opcional: assina o corpo com HMAC-SHA256 no header X-FinanceBot-Signature,
# para o fluxo do n8n provar que a chamada veio deste deploy.
N8N_WEBHOOK_SECRET=

# Webhook dedicado para reset de senha — separado do N8N_WEBHOOK_URL acima
# de propósito, para um link de reset nunca poder ser roteado pelo mesmo
# fluxo que posta nos grupos de WhatsApp dos eventos. Não há provedor de
# e-mail configurado neste app: é este webhook que entrega o link (ex: via
# WhatsApp direto para o número da pessoa). Sem esta URL, o link só aparece
# no log do servidor.
N8N_PASSWORD_RESET_WEBHOOK_URL=
# Opcional, mesmo esquema do N8N_WEBHOOK_SECRET acima.
N8N_PASSWORD_RESET_WEBHOOK_SECRET=

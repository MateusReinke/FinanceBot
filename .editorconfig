# Keeps whitespace consistent regardless of editor. Matches the Prettier
# config next to it — .prettierrc.json is the authority for code style;
# this covers the files Prettier does not format.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
